####
# Multi-Architecture Dockerfile for Bitbucket MCP Server - Native Image
# Optimized for linux/amd64 and linux/arm64
# Uses GraalVM to build native executable with Quarkus
#
# Build with:
# docker buildx build --platform linux/amd64,linux/arm64 -t bitbucket-mcp-server:native .
####

# Stage 1: Build native executable with GraalVM
# The glibc-based image is required: the musl variant (native-image-community:21-muslib)
# cannot compile the native-image C-ABI query code (musl lacks glibc-specific locale
# constants such as LC_ADDRESS/Lmid_t), and muslib images are published for x86_64 only.
FROM ghcr.io/graalvm/native-image-community:21 AS build

WORKDIR /build

# Install Maven
RUN microdnf install -y wget tar gzip && \
    wget https://archive.apache.org/dist/maven/maven-3/3.9.6/binaries/apache-maven-3.9.6-bin.tar.gz && \
    tar xzf apache-maven-3.9.6-bin.tar.gz -C /opt && \
    ln -s /opt/apache-maven-3.9.6 /opt/maven && \
    microdnf clean all

ENV MAVEN_HOME=/opt/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"

# Copy Maven wrapper and pom.xml first for better layer caching
COPY .mvn/ .mvn/
COPY mvnw mvnw.cmd pom.xml ./

# Download dependencies (cached if pom.xml hasn't changed)
RUN ./mvnw dependency:go-offline -B

# Copy source code
COPY src ./src

# Build native executable. -H:+StaticExecutableWithDynamicLibC produces a
# mostly-static binary (all application and JDK libraries statically linked,
# only libc left dynamic) so it runs on the minimal distroless base image,
# which does not ship additional shared libraries such as libz.
RUN ./mvnw package -Dnative -DskipTests -B \
    -Dquarkus.native.additional-build-args=-H:+StaticExecutableWithDynamicLibC

# Stage 2: Runtime image - minimal distroless (Debian 12, glibc) base
FROM gcr.io/distroless/base-debian12:nonroot

WORKDIR /work

# Copy the native executable from build stage
COPY --from=build /build/target/*-runner /work/application

# Set permissions
USER nonroot:nonroot

EXPOSE 8080

ENV QUARKUS_HTTP_HOST=0.0.0.0

# No HEALTHCHECK is defined: the distroless base image ships no shell, wget,
# or curl, so there is no lightweight HTTP client to probe the endpoint with.
# (Running the application itself as the health check is not viable, as it
# starts the server and never exits.) This matches the official Quarkus
# native-image Dockerfile convention.

ENTRYPOINT ["/work/application"]
CMD ["-Dquarkus.http.host=0.0.0.0"]
